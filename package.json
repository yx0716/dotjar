{
  "name": "dotjar",
  "version": "0.4.0",
  "private": true,
  "description": "把今天和 AI agent 的对话看成一条银河：告诉你怎么把 agent 用得更好，捞起值得长期留下的策略、经验和盲点，隔一阵提醒你歇一歇、回看刚才做了什么。",
  "repository": "github:yx0716/dotjar",
  "keywords": ["agent", "claude-code", "codex", "cursor", "learning", "reflection", "notes"],
  "license": "MIT",
  "main": "src/main.js",
  "type": "commonjs",
  "bin": {
    "dotjar": "bin/dotjar.js"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "start": "node bin/dotjar.js web",
    "stop": "node bin/dotjar.js stop",
    "service": "node bin/dotjar.js service install",
    "service:off": "node bin/dotjar.js service uninstall",
    "demo": "node bin/dotjar.js demo",
    "veil": "electron .",
    "veil:demo": "electron . --demo",
    "scan": "node bin/dotjar.js scan",
    "distill": "node bin/dotjar.js distill",
    "library": "node bin/dotjar.js library",
    "test": "node --test",
    "shot": "electron . --demo --shot",
    "icon": "electron scripts/make-icon.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "41.0.2"
  }
}
